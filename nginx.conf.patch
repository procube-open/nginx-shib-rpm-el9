--- nginx.conf
+++ nginx.conf
@@ -2,12 +2,13 @@
 user  nginx;
 worker_processes  auto;
 
-error_log  /var/log/nginx/error.log notice;
+error_log  stderr warn;
 pid        /run/nginx.pid;
 
+worker_rlimit_nofile 40960;
 
 events {
-    worker_connections  1024;
+    worker_connections  10240;
 }
 
 
